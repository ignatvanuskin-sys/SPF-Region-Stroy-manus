# Порт. Railway подставляет свой PORT автоматически — значение ниже только для локального запуска.
PORT=3000

# Каталог заявок. На Railway укажите путь смонтированного постоянного диска (например /data),
# иначе заявки будут писаться внутрь контейнера и исчезнут при передеплое.
# LEADS_DIR=/data

# Канал доставки 1: вебхук CRM. Пока пусто — заявка только сохраняется на сервере,
# и клиент видит статус «заявка сохранена», а не «передана менеджеру».
CRM_WEBHOOK_URL=
CRM_API_TOKEN=

# Канал доставки 2: Telegram-бот. Заполните оба поля, чтобы менеджер получал заявки в чат.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Телефон для WhatsApp-ссылок (только цифры, без +).
WHATSAPP_PHONE=77018936787

# Если фронтенд когда-нибудь переедет на другой домен — укажите его здесь, чтобы включить CORS.
# По умолчанию CORS выключен: сайт и API на одном домене.
ALLOWED_ORIGIN=

# Аналитика: пока не задано — события никуда не отправляются (см. src/lib/analytics.ts).
VITE_ANALYTICS_ENDPOINT=
